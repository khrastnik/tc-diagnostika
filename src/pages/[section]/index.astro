---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { u, SECTIONS, fmtDate, type SectionKey } from '../../lib/url';

export function getStaticPaths() {
  return Object.keys(SECTIONS).map((section) => ({ params: { section } }));
}
const section = Astro.params.section as SectionKey;
const s = SECTIONS[section];
const items = (await getCollection('clanki', (a) => a.data.section === section))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
---
<Base title={s.title} description={s.intro}>
  <nav class="crumbs" aria-label="Drobtinice"><ol><li><a href={u('/')}>Domov</a></li><li>{s.title}</li></ol></nav>
  <h1>{s.title}</h1>
  <p class="lead">{s.intro}</p>
  {items.length === 0 ? (
    <p>Prvi članki v tem razdelku so v pripravi.</p>
  ) : (
    <ul class="list">
      {items.map((a) => (
        <li>
          <a href={u(`/${section}/${a.id}/`)}>{a.data.title}</a>
          <p>{a.data.description}</p>
          <p class="meta">Posodobljeno {fmtDate(a.data.updated)}</p>
        </li>
      ))}
    </ul>
  )}
</Base>
