---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHead from '../../components/PageHead.astro';
import SectionTabs from '../../components/SectionTabs.astro';
import PostCard from '../../components/PostCard.astro';
import { SECTIONS, type SectionKey } from '../../lib/url';

export function getStaticPaths() {
  return Object.keys(SECTIONS).map((section) => ({ params: { section } }));
}
const section = Astro.params.section as SectionKey;
const s = SECTIONS[section];
const items = (await getCollection('clanki', (a) => a.data.section === section))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
---
<Base title={s.title} description={s.intro}>
  <PageHead title={s.title} lead={s.intro} crumbs={[[s.title]]} art={section} color={s.color} icon={s.icon} tag={`${items.length} ${items.length === 1 ? 'članek' : items.length === 2 ? 'članka' : items.length > 0 && items.length < 5 ? 'članki' : 'člankov'}`} />
  <SectionTabs current={section} />
  <section class="section" style="padding-top:2rem">
    <div class="container">
      {items.length === 0 ? (
        <div class="empty reveal">
          <Icon name="calendar" />
          <h2>Prvi članki so v pripravi</h2>
          <p>Tu bodo subvencije, predpisi in cene, vsak z datumom posodobitve in povezavo na uradni vir.</p>
        </div>
      ) : (
        <h2 class="sr-only">Članki v razdelku {s.title}</h2>
        <div class="posts three">{items.map((a, i) => <PostCard entry={a} delay={(i % 3) * 0.08} />)}</div>
      )}
    </div>
  </section>
</Base>
