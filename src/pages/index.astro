---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HeroArt from '../components/HeroArt.astro';
import CycleDiagram from '../components/CycleDiagram.astro';
import PostCard from '../components/PostCard.astro';
import { u, SITE_NAME, SECTIONS } from '../lib/url';

const all = (await getCollection('clanki')).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
const terms = (await getCollection('slovar')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'sl'));
const desc = 'Kako toplotne črpalke delujejo, zakaj se kvarijo in kaj je aktualno: subvencije, predpisi, cene. Razloženo preprosto, v slovenščini.';
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, inLanguage: 'sl', url: new URL(u('/'), Astro.site).href }];
const symptoms = [
  { icon: 'thermo', label: 'Ne greje dovolj', href: '/zakaj-se-kvarijo/toplotna-crpalka-ne-greje-dovolj/' },
  { icon: 'snow', label: 'Zunanja enota je zaledenela', href: '/zakaj-se-kvarijo/toplotna-crpalka-ne-greje-dovolj/' },
  { icon: 'power', label: 'Pogosto se vklaplja in izklaplja', soon: true },
  { icon: 'volume', label: 'Je glasnejša kot prej', soon: true },
];
---
<Base title={SITE_NAME} description={desc} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Vaša toplotna črpalka, <em>razložena po domače.</em></h1>
        <p class="lead">Kako deluje, zakaj se kvari in kdaj je čas za strokovnjaka. Jasni odgovori namesto nasprotujočih si forumskih nasvetov.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={u('/zakaj-se-kvarijo/')}>Imam težavo s črpalko <Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={u('/kako-deluje/')}>Kako deluje</a>
        </div>
        <ul class="trust">
          <li><Icon name="shield" />Varno: brez posegov v hladilni krog</li>
          <li><Icon name="check" />Z navedenimi viri</li>
        </ul>
      </div>
      <div class="hero-art"><HeroArt /></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div><h2>Kje začeti</h2><p>Tri poti, glede na to, kaj vas zanima.</p></div>
      </div>
      <div class="pillars">
        {Object.entries(SECTIONS).map(([key, s], i) => (
          <a class={`pillar c-${s.color} reveal`} style={`--d:${i * 0.08}s`} href={u(`/${key}/`)}>
            <span class="icon-badge"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <p>{s.intro}</p>
            <span class="more">Odpri razdelek <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="help-box reveal">
        <div>
          <span class="tag tag-warm">Hitra pomoč</span>
          <h2>Kaj se dogaja z vašo črpalko?</h2>
          <p>Izberite znak, ki ga opazite. Povemo, kaj je normalno, kaj lahko varno preverite sami in kdaj poklicati serviserja.</p>
        </div>
        <ul class="symptoms">
          {symptoms.map((s) => (
            <li>
              {s.soon ? (
                <span class="symptom soon"><Icon name={s.icon} /><span>{s.label}<small>Članek v pripravi</small></span></span>
              ) : (
                <a class="symptom" href={u(s.href!)}><Icon name={s.icon} /><span>{s.label}</span></a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head reveal">
        <div><h2>Krog v štirih korakih</h2><p>Toplotna črpalka toplote ne proizvaja, ampak jo prenaša.</p></div>
        <a class="link-arrow" href={u('/kako-deluje/kako-deluje-toplotna-crpalka/')}>Preberi razlago <Icon name="arrow" /></a>
      </div>
      <div class="reveal"><CycleDiagram /></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div><h2>Najnovejši članki</h2><p>Novi članki vsak teden.</p></div>
      </div>
      <div class="posts three">
        {all.slice(0, 6).map((a, i) => <PostCard entry={a} delay={(i % 3) * 0.08} />)}
      </div>
    </div>
  </section>


  <section class="section section-alt">
    <div class="container glossary-band">
      <div class="reveal">
        <span class="tag tag-teal">Slovar</span>
        <h2 style="font-size:clamp(1.5rem,4vw,2rem);margin:.6rem 0 .5rem;font-weight:800">Pojmi, razloženi v enem stavku</h2>
        <p style="color:var(--muted);margin:0 0 1rem">Kompresor, uparjalnik, hladivo … ko naletite na neznano besedo.</p>
        <a class="link-arrow" href={u('/slovar/')}>Odpri slovar <Icon name="arrow" /></a>
      </div>
      <ul class="chips reveal" style="--d:.1s">
        {terms.map((t) => <li><a class="chip" href={u(`/slovar/${t.id}/`)}><Icon name="book" class="" />{t.data.title}</a></li>)}
      </ul>
    </div>
  </section>
</Base>
