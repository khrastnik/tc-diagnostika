---
---
<svg class="hero-svg" viewBox="0 0 560 460" role="img" aria-labelledby="hero-t">
  <title id="hero-t">Hiša s toplotno črpalko: zunanja enota jemlje toploto iz zraka in jo prenaša v hišo</title>
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#eaf6f2"/><stop offset="1" stop-color="#ffffff"/></linearGradient>
    <linearGradient id="wall" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#f1f5f3"/></linearGradient>
    <linearGradient id="roof" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#1b3a32"/><stop offset="1" stop-color="#0e1f1a"/></linearGradient>
    <linearGradient id="unit" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#e7eeeb"/></linearGradient>
    <linearGradient id="hot" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#f59e7c"/><stop offset="1" stop-color="#e8603c"/></linearGradient>
    <linearGradient id="window" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffe2b8"/><stop offset="1" stop-color="#ffc58a"/></linearGradient>
    <radialGradient id="glow" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#ffb08f" stop-opacity=".55"/><stop offset="1" stop-color="#ffb08f" stop-opacity="0"/></radialGradient>
    <clipPath id="fanclip"><circle cx="0" cy="0" r="34"/></clipPath>
  </defs>

  <!-- backdrop -->
  <rect x="10" y="20" width="540" height="420" rx="36" fill="url(#sky)"/>
  <g class="cloud c1"><ellipse cx="110" cy="80" rx="38" ry="14" fill="#fff"/><ellipse cx="135" cy="72" rx="24" ry="14" fill="#fff"/></g>
  <g class="cloud c2"><ellipse cx="430" cy="62" rx="30" ry="11" fill="#fff"/><ellipse cx="450" cy="56" rx="18" ry="11" fill="#fff"/></g>
  <circle class="sun" cx="480" cy="110" r="22" fill="#ffd27a"/>
  <!-- ground -->
  <path d="M10 380h540v24a36 36 0 0 1-36 36H46a36 36 0 0 1-36-36z" fill="#d9efe7"/>
  <rect x="10" y="372" width="540" height="12" fill="#c3e6da"/>

  <!-- house -->
  <rect x="190" y="200" width="250" height="176" rx="6" fill="url(#wall)" stroke="#d6e0dc" stroke-width="2"/>
  <path d="M170 210 315 112l145 98z" fill="url(#roof)"/>
  <rect x="380" y="128" width="26" height="50" rx="3" fill="#24463c"/>
  <circle class="warm-glow" cx="315" cy="290" r="120" fill="url(#glow)"/>
  <!-- windows -->
  <g><rect x="218" y="232" width="66" height="54" rx="6" fill="url(#window)" stroke="#e9b98a" stroke-width="2"/><path d="M251 232v54M218 259h66" stroke="#fff" stroke-width="3"/></g>
  <g><rect x="346" y="232" width="66" height="54" rx="6" fill="url(#window)" stroke="#e9b98a" stroke-width="2"/><path d="M379 232v54M346 259h66" stroke="#fff" stroke-width="3"/></g>
  <rect x="292" y="304" width="46" height="72" rx="5" fill="#0e7a63"/><circle cx="330" cy="342" r="3" fill="#ffd27a"/>
  <!-- radiator inside -->
  <g transform="translate(222 318)"><rect width="52" height="34" rx="5" fill="#fff" stroke="#e8603c" stroke-width="2"/><path d="M10 6v22M20 6v22M30 6v22M40 6v22" stroke="#f3a084" stroke-width="3" stroke-linecap="round"/></g>
  <g class="heat-waves" stroke="#e8603c" stroke-width="2.2" fill="none" stroke-linecap="round">
    <path d="M232 312c-4-6 4-10 0-16"/><path d="M248 312c-4-6 4-10 0-16"/><path d="M264 312c-4-6 4-10 0-16"/>
  </g>

  <!-- pipes from unit to house -->
  <path d="M150 352 H190" stroke="#cfd9d5" stroke-width="10" stroke-linecap="round"/>
  <path class="flow flow-hot" d="M150 346 H222" stroke="url(#hot)" stroke-width="4" stroke-linecap="round" fill="none"/>
  <path class="flow flow-cold" d="M222 358 H150" stroke="#5aa9e6" stroke-width="4" stroke-linecap="round" fill="none"/>

  <!-- outdoor unit -->
  <g transform="translate(40 290)">
    <rect x="0" y="80" width="12" height="10" rx="2" fill="#9fb1aa"/><rect x="98" y="80" width="12" height="10" rx="2" fill="#9fb1aa"/>
    <rect x="-6" y="0" width="122" height="84" rx="10" fill="url(#unit)" stroke="#cfd9d5" stroke-width="2"/>
    <g transform="translate(46 42)">
      <circle r="34" fill="#f1f5f3" stroke="#cfd9d5" stroke-width="2"/>
      <g class="fan" clip-path="url(#fanclip)">
        <path d="M0 0C6-14 2-28-6-30C-10-20-8-8 0 0z" fill="#0a7d65"/>
        <path d="M0 0C14 6 28 2 30-6C20-10 8-8 0 0z" fill="#13a07f"/>
        <path d="M0 0C-6 14-2 28 6 30C10 20 8 8 0 0z" fill="#0a7d65"/>
        <path d="M0 0C-14-6-28-2-30 6C-20 10-8 8 0 0z" fill="#13a07f"/>
      </g>
      <circle r="6" fill="#fff" stroke="#0a7d65" stroke-width="2"/>
      <path d="M-34 0h68M0-34v68" stroke="#cfd9d5" stroke-width="1" opacity=".6"/>
    </g>
    <g fill="#cfd9d5"><rect x="90" y="16" width="16" height="3" rx="1.5"/><rect x="90" y="24" width="16" height="3" rx="1.5"/><rect x="90" y="32" width="16" height="3" rx="1.5"/></g>
    <circle class="led" cx="98" cy="68" r="3.5" fill="#22c55e"/>
  </g>

  <!-- air intake arrows -->
  <g class="air" stroke="#5aa9e6" stroke-width="3" fill="none" stroke-linecap="round">
    <path class="a1" d="M18 300c14-6 22 6 36 0"/>
    <path class="a2" d="M14 320c14-6 22 6 36 0"/>
    <path class="a3" d="M20 340c14-6 22 6 36 0"/>
  </g>

  <!-- floating stat cards -->
  <g class="float f1" transform="translate(28 150)">
    <rect width="132" height="62" rx="14" fill="#fff" stroke="#e2e9e6"/>
    <text x="16" y="26" font-size="12" fill="#5b6b65" font-family="inherit" font-weight="600">Zunaj</text>
    <text x="16" y="48" font-size="20" fill="#2b6be0" font-family="inherit" font-weight="800">−5 °C</text>
    <circle cx="108" cy="31" r="12" fill="#edf3ff"/><path d="M108 23v16M101 27l14 8M101 35l14-8" stroke="#2b6be0" stroke-width="2" stroke-linecap="round"/>
  </g>
  <g class="float f2" transform="translate(402 254)">
    <rect width="132" height="62" rx="14" fill="#fff" stroke="#e2e9e6"/>
    <text x="16" y="26" font-size="12" fill="#5b6b65" font-family="inherit" font-weight="600">Doma</text>
    <text x="16" y="48" font-size="20" fill="#e8603c" font-family="inherit" font-weight="800">21 °C</text>
    <circle cx="108" cy="31" r="12" fill="#fff1eb"/><path d="M110 37V24a2 2 0 1 0-4 0v13a4 4 0 1 0 4 0z" stroke="#e8603c" stroke-width="2" fill="none"/>
  </g>
  <g class="float f3" transform="translate(372 150)">
    <rect width="150" height="44" rx="22" fill="#0e1f1a"/>
    <circle cx="22" cy="22" r="10" fill="#0a7d65"/><path d="m17 22 3.5 3.5L27 19" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <text x="40" y="27" font-size="13" fill="#fff" font-family="inherit" font-weight="700">COP 4 · 1→4 kWh</text>
  </g>
</svg>

<style>
  .hero-svg { width: 100%; height: auto; overflow: visible; }
  .fan { transform-box: fill-box; transform-origin: center; animation: spin 2.4s linear infinite; }
  .flow { stroke-dasharray: 10 10; animation: dash 1.1s linear infinite; }
  .flow-cold { animation-duration: 1.4s; }
  .led { animation: blink 2.6s ease-in-out infinite; }
  .air path { stroke-dasharray: 46; stroke-dashoffset: 46; opacity: .9; animation: air 2.8s ease-in-out infinite; }
  .air .a2 { animation-delay: .5s; } .air .a3 { animation-delay: 1s; }
  .heat-waves path { animation: rise 2.4s ease-in-out infinite; opacity: 0; }
  .heat-waves path:nth-child(2) { animation-delay: .4s; } .heat-waves path:nth-child(3) { animation-delay: .8s; }
  .warm-glow { animation: pulse 4s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .float { animation: bob 6s ease-in-out infinite; }
  .f2 { animation-delay: -2s; } .f3 { animation-delay: -4s; }
  .cloud { animation: drift 18s ease-in-out infinite alternate; }
  .c2 { animation-duration: 24s; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes dash { to { stroke-dashoffset: -20; } }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
  @keyframes air { 0% { stroke-dashoffset: 46; opacity: 0; } 30% { opacity: 1; } 70% { stroke-dashoffset: 0; opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes rise { 0% { transform: translateY(6px); opacity: 0; } 40% { opacity: 1; } 100% { transform: translateY(-10px); opacity: 0; } }
  @keyframes pulse { 0%, 100% { opacity: .7; transform: scale(.96); } 50% { opacity: 1; transform: scale(1.04); } }
  @keyframes bob { 0%, 100% { translate: 0 0; } 50% { translate: 0 -8px; } }
  @keyframes drift { from { translate: -10px 0; } to { translate: 14px 0; } }
  @media (prefers-reduced-motion: reduce) { .hero-svg * { animation: none !important; } }
</style>
