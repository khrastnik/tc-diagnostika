---
import Crumbs from './Crumbs.astro';
import Icon from './Icon.astro';
import SectionArt from './SectionArt.astro';
interface Props { title: string; lead: string; crumbs: [string, string?][]; art: string; color?: string; icon?: string; tag?: string; }
const { title, lead, crumbs, art, color = 'teal', icon, tag } = Astro.props;
---
<header class={`page-head c-${color}`}>
  <div class="container ph-grid">
    <div class="ph-copy">
      <Crumbs items={crumbs} />
      {(icon || tag) && (
        <div class="row" style="margin-top:1.25rem">
          {icon && <span class="icon-badge"><Icon name={icon} /></span>}
          {tag && <span class={`tag tag-${color}`}>{tag}</span>}
        </div>
      )}
      <h1 style={!(icon || tag) ? 'margin-top:1.25rem' : ''}>{title}</h1>
      <p class="lead">{lead}</p>
      <slot />
    </div>
    <div class="ph-art"><SectionArt kind={art} /></div>
  </div>
</header>
