{
  // Cloudflare Workers – statična stran (brez strežniške kode).
  // Gradnja: npm run build  ->  dist/   Objava: npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toplolog",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Predogledi vej (Workers Builds: npx wrangler preview); prazen blok je dovolj.
  "previews": {}
}
