---
// Stran za star naslov: preusmeri na novega (za gostovanja brez strežniških preusmeritev, npr. GitHub Pages).
interface Props { to: string; }
const { to } = Astro.props;
const abs = new URL(to, Astro.site).href;
---
<!doctype html>
<html lang="sl"><head>
  <meta charset="utf-8" />
  <title>Stran je preseljena – Toplolog</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={abs} />
  <meta http-equiv="refresh" content={`0; url=${to}`} />
  <script is:inline define:vars={{ to }}>location.replace(to + location.hash);</script>
</head><body style="font-family:system-ui,sans-serif;padding:2rem">
  <p>Stran je preseljena: <a href={to}>{abs}</a></p>
</body></html>
