---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHead from '../../components/PageHead.astro';
import SectionTabs from '../../components/SectionTabs.astro';
import { u } from '../../lib/url';
const terms = (await getCollection('slovar')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'sl'));
---
<Base title="Slovar pojmov" description="Kratke razlage pojmov o toplotnih črpalkah: kompresor, uparjalnik, hladivo, odtaljevanje in drugi.">
  <PageHead title="Slovar pojmov" lead="Ena stran na pojem, kratek odgovor in povezava naprej." crumbs={[['Slovar']]} art="slovar" icon="book" tag={`${terms.length} pojmov`} />
  <SectionTabs current="slovar" />
  <section class="section" style="padding-top:2rem">
    <div class="container">
      <div class="search"><Icon name="book" /><input id="q" type="search" placeholder="Poišči pojem, npr. kompresor" aria-label="Poišči pojem" autocomplete="off" /></div>
      <p class="no-results" id="none">Ni zadetkov. Poskusite z drugo besedo.</p>
    <div class="az">
      {terms.map((t, i) => (
        <a class="term-tile reveal" data-q={`${t.data.title} ${t.data.description}`.toLowerCase()} style={`--d:${(i % 3) * 0.06}s`} href={u(`/slovar/${t.id}/`)}>
          <span class="letter">{t.data.title[0]}</span>
          <div><h3>{t.data.title}</h3><p>{t.data.description}</p></div>
        </a>
      ))}
    </div>
    </div>
  </section>
  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const tiles = [...document.querySelectorAll<HTMLElement>('.term-tile')];
    const none = document.getElementById('none') as HTMLElement;
    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    q.addEventListener('input', () => {
      const v = norm(q.value.trim()); let n = 0;
      for (const t of tiles) { const hit = !v || norm(t.dataset.q || '').includes(v); t.style.display = hit ? '' : 'none'; if (hit) { n++; t.classList.add('in'); } }
      none.style.display = n ? 'none' : 'block';
    });
  </script>
</Base>
