---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Waitlist from '../components/Waitlist.astro';
import { WAITLIST_ACTION } from '../lib/config';
import { u, SITE_NAME, SECTIONS, fmtDate, readingTime, type SectionKey } from '../lib/url';

const all = (await getCollection('clanki')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.data.updated.valueOf() - a.data.updated.valueOf() || a.id.localeCompare(b.id),
);
const [first, ...rest] = all;
const terms = (await getCollection('slovar')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'sl'));
const sec = (key: string) => SECTIONS[key as SectionKey];
const href = (a: (typeof all)[number]) => u(`/${a.data.section}/${a.id}/`);
const counts = Object.fromEntries(Object.keys(SECTIONS).map((k) => [k, all.filter((a) => a.data.section === k).length]));
const desc = 'Članki in novice o toplotnih črpalkah v slovenščini: kako delujejo, zakaj se kvarijo, koliko stane servis in kaj je novega pri subvencijah.';
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, inLanguage: 'sl', url: new URL(u('/'), Astro.site).href }];
const symptoms = [
  { label: 'Ne greje dovolj', href: '/tezave/toplotna-crpalka-ne-greje-dovolj/' },
  { label: 'Zunanja enota je zaledenela', href: '/kako-deluje/zakaj-crpalka-pozimi-odtaljuje/' },
  { label: 'Pogosto se vklaplja in izklaplja', href: '/tezave/zakaj-se-crpalka-pogosto-vklaplja-in-izklaplja/' },
  { label: 'Je glasnejša kot prej', href: '/vzdrzevanje/znaki-da-crpalka-potrebuje-servis/' },
];
---
<Base title={SITE_NAME} description={desc} jsonLd={jsonLd}>
  <header class="masthead">
    <div class="container">
      <h1>Članki in novice o toplotnih črpalkah</h1>
      <p>Kako delujejo, zakaj se kvarijo, koliko stane servis in kaj je novega pri subvencijah. Pišem v slovenščini in navajam vire.</p>
    </div>
  </header>

  <div class="container mag">
    <div>
      {first && (
        <article class="lead-story">
          <p class="kick"><a href={u(`/${first.data.section}/`)}>{sec(first.data.section).title}</a> · <time datetime={first.data.pubDate.toISOString()}>{fmtDate(first.data.pubDate)}</time></p>
          <h2><a href={href(first)}>{first.data.title}</a></h2>
          <p>{first.data.description}</p>
          <p class="meta">Piše Klemen · {readingTime(first.body)} min branja</p>
        </article>
      )}

      <ol class="stories">
        {rest.map((a) => (
          <li class="story">
            <p class="kick"><a href={u(`/${a.data.section}/`)}>{sec(a.data.section).title}</a><br /><time datetime={a.data.pubDate.toISOString()}>{fmtDate(a.data.pubDate)}</time></p>
            <div>
              <h3><a href={href(a)}>{a.data.title}</a></h3>
              <p>{a.data.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <aside class="side">
      <section>
        <h2>O strani</h2>
        <p>Toplolog piše Klemen. Tu so razlage, novice in zanimivosti o toplotnih črpalkah, z navedenimi viri.</p>
        <a href={u('/o-meni/')}>Več o meni</a>
      </section>
      <section>
        <h2>Ko nekaj ne dela</h2>
        <ul>{symptoms.map((s) => <li><a href={u(s.href)}>{s.label}</a></li>)}</ul>
      </section>
      <section>
        <h2>Rubrike</h2>
        <ul>{Object.entries(SECTIONS).map(([key, s]) => <li><a href={u(`/${key}/`)}>{s.title}</a> <span class="count">{counts[key]}</span></li>)}</ul>
      </section>
      <section>
        <h2>Slovar</h2>
        <span class="terms">{terms.map((t, i) => <>{i > 0 && ' · '}<a href={u(`/slovar/${t.id}/`)}>{t.data.title}</a></>)}</span>
      </section>
    </aside>
  </div>

  {WAITLIST_ACTION && (
    <section class="section" style="padding-top:0">
      <div class="container"><Waitlist /></div>
    </section>
  )}
</Base>
