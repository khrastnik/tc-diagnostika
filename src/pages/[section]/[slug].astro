---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { u, SECTIONS, SITE_NAME, fmtDate } from '../../lib/url';

export async function getStaticPaths() {
  const all = await getCollection('clanki');
  return all.map((entry) => ({ params: { section: entry.data.section, slug: entry.id }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const s = SECTIONS[d.section];
const related = (d.related ?? []).map((id) => all.find((a) => a.id === id)).filter(Boolean);
const glossary = d.terms?.length
  ? (await getCollection('slovar')).filter((t) => d.terms!.includes(t.id))
  : [];
const abs = (p: string) => new URL(u(p), Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description,
    datePublished: d.pubDate.toISOString(), dateModified: d.updated.toISOString(), inLanguage: 'sl',
    mainEntityOfPage: abs(`/${d.section}/${entry.id}/`), publisher: { '@type': 'Organization', name: SITE_NAME },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Domov', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: s.title, item: abs(`/${d.section}/`) },
      { '@type': 'ListItem', position: 3, name: d.title },
    ],
  },
];
---
<Base title={d.title} description={d.description} jsonLd={jsonLd}>
  <nav class="crumbs" aria-label="Drobtinice"><ol>
    <li><a href={u('/')}>Domov</a></li><li><a href={u(`/${d.section}/`)}>{s.title}</a></li><li>{d.title}</li>
  </ol></nav>
  <article>
    <h1>{d.title}</h1>
    <p class="meta">Objavljeno {fmtDate(d.pubDate)} · posodobljeno <time datetime={d.updated.toISOString()}>{fmtDate(d.updated)}</time></p>
    <div class="prose"><Content /></div>

    {d.remember && (
      <aside class="remember"><h2>Kaj to pomeni za vas</h2><ul>{d.remember.map((r) => <li>{r}</li>)}</ul></aside>
    )}

    {d.section === 'zakaj-se-kvarijo' && (
      <p class="notice">Če znaki ostanejo ali gre za karkoli v hladilnem krogu (puščanje, zmrzal na ceveh, napake tlaka), pokličite <strong>pooblaščenega serviserja s spričevalom za F-pline</strong>. Posegi v hladilni krog brez spričevala niso dovoljeni in so nevarni.</p>
    )}

    {d.sources && (
      <section class="sources"><h2>Viri</h2><ul>{d.sources.map((src) => <li><a href={src.url} rel="noopener">{src.name}</a></li>)}</ul></section>
    )}

    {glossary.length > 0 && (
      <section><h2>Pojmi v članku</h2><ul>{glossary.map((t) => <li><a href={u(`/slovar/${t.id}/`)}>{t.data.title}</a>: {t.data.description}</li>)}</ul></section>
    )}

    {related.length > 0 && (
      <section><h2>Preberite še</h2><ul class="list">{related.map((r) => <li><a href={u(`/${r!.data.section}/${r!.id}/`)}>{r!.data.title}</a><p>{r!.data.description}</p></li>)}</ul></section>
    )}
  </article>
</Base>
