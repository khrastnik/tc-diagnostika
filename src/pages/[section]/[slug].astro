---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Crumbs from '../../components/Crumbs.astro';
import PostCard from '../../components/PostCard.astro';
import CycleDiagram from '../../components/CycleDiagram.astro';
import { u, SECTIONS, SITE_NAME, fmtDate, readingTime } from '../../lib/url';

export async function getStaticPaths() {
  const all = await getCollection('clanki');
  return all.map((entry) => ({ params: { section: entry.data.section, slug: entry.id }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const s = SECTIONS[d.section];
const related = (d.related ?? []).map((id) => all.find((a) => a.id === id)).filter(Boolean);
const glossary = d.terms?.length ? (await getCollection('slovar')).filter((t) => d.terms!.includes(t.id)) : [];
const abs = (p: string) => new URL(u(p), Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description,
    datePublished: d.pubDate.toISOString(), dateModified: d.updated.toISOString(), inLanguage: 'sl',
    mainEntityOfPage: abs(`/${d.section}/${entry.id}/`), publisher: { '@type': 'Organization', name: SITE_NAME },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Domov', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: s.title, item: abs(`/${d.section}/`) },
      { '@type': 'ListItem', position: 3, name: d.title },
    ],
  },
];
---
<Base title={d.title} description={d.description} jsonLd={jsonLd}>
  <article>
    <header class="article-head">
      <div class="container read" style="max-width:calc(var(--readw) + 3rem)">
        <Crumbs items={[[s.title, `/${d.section}/`], [d.title]]} />
        <div style="margin-top:1.25rem"><span class={`tag tag-${s.color}`}>{s.title}</span></div>
        <h1>{d.title}</h1>
        <p class="desc">{d.description}</p>
        <div class="byline">
          <span><Icon name="clock" />{readingTime(entry.body)} min branja</span>
          <span><Icon name="calendar" />Objavljeno {fmtDate(d.pubDate)}</span>
          <span><Icon name="refresh" />Posodobljeno <time datetime={d.updated.toISOString()}>{fmtDate(d.updated)}</time></span>
        </div>
      </div>
    </header>

    <div class="article-body">
      <div class="container read" style="max-width:calc(var(--readw) + 3rem)">
        <div class="prose"><Content /></div>

        {entry.id === 'kako-deluje-toplotna-crpalka' && <CycleDiagram />}

        {d.remember && (
          <aside class="callout callout-teal">
            <Icon name="bulb" />
            <div><h2>Kaj to pomeni za vas</h2><ul>{d.remember.map((r) => <li>{r}</li>)}</ul></div>
          </aside>
        )}

        {d.section === 'zakaj-se-kvarijo' && (
          <aside class="callout callout-warn">
            <Icon name="alert" />
            <p>Če znaki ostanejo ali gre za karkoli v hladilnem krogu (puščanje, zmrzal na ceveh, napake tlaka), pokličite <strong>pooblaščenega serviserja s spričevalom za F-pline</strong>. Posegi v hladilni krog brez spričevala niso dovoljeni in so nevarni.</p>
          </aside>
        )}

        <aside class="cta-band">
          <div><h2>Potrebujete pregled?</h2><p>Pridem na dom, izmerim delovanje in vam v poročilu povem, kaj storiti.</p></div>
          <a class="btn btn-primary" href={u('/narocilo/')}>Naroči pregled <Icon name="arrow" /></a>
        </aside>

        {d.sources && (
          <section class="sources"><h2 class="subhead">Viri</h2><ul>{d.sources.map((src) => <li><a href={src.url} rel="noopener">{src.name}</a></li>)}</ul></section>
        )}

        {glossary.length > 0 && (
          <section>
            <h2 class="subhead">Pojmi v članku</h2>
            <ul class="terms-list">{glossary.map((t) => <li><a class="term-card" href={u(`/slovar/${t.id}/`)}><b>{t.data.title}</b>{t.data.description}</a></li>)}</ul>
          </section>
        )}
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <div class="section-head"><div><h2>Preberite še</h2></div></div>
        <div class="posts three">{related.map((r, i) => <PostCard entry={r} delay={i * 0.08} />)}</div>
      </div>
    </section>
  )}
</Base>
