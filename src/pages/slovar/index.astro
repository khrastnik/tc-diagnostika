---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { u } from '../../lib/url';
const terms = (await getCollection('slovar')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'sl'));
---
<Base title="Slovar pojmov" description="Kratke razlage pojmov o toplotnih črpalkah: kompresor, uparjalnik, hladivo, odtaljevanje in drugi.">
  <nav class="crumbs" aria-label="Drobtinice"><ol><li><a href={u('/')}>Domov</a></li><li>Slovar</li></ol></nav>
  <h1>Slovar pojmov</h1>
  <p class="lead">Ena stran na pojem, kratek odgovor in povezava naprej.</p>
  <ul class="list">
    {terms.map((t) => <li><a href={u(`/slovar/${t.id}/`)}>{t.data.title}</a><p>{t.data.description}</p></li>)}
  </ul>
</Base>
