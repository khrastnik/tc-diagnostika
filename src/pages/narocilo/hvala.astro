---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { u } from '../../lib/url';
---
<Base title="Hvala za naročilo" description="Vaše naročilo na pregled je oddano." noindex>
  <section class="section">
    <div class="container" style="max-width:36rem;text-align:center">
      <div class="success-mark"><Icon name="check" /></div>
      <h1 style="font-size:clamp(1.9rem,6vw,2.6rem);margin:1.25rem 0 .75rem">Hvala, naročilo je oddano</h1>
      <p style="color:var(--muted);margin:0 0 1.75rem">Poklical vas bom v dveh delovnih dneh. Medtem si lahko preberete, kaj lahko varno preverite sami.</p>
      <div class="hero-actions" style="justify-content:center">
        <a class="btn btn-primary" href={u('/zakaj-se-kvarijo/')}>Pogoste težave <Icon name="arrow" /></a>
        <a class="btn btn-ghost" href={u('/')}>Domov</a>
      </div>
    </div>
  </section>
</Base>
